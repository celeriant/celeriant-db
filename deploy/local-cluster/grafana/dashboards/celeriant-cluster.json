{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Cluster Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Node Role",
      "description": "1 = Leader, 0 = Follower",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "celeriant_node_role", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Follower", "color": "blue" }, "1": { "text": "Leader", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Active Client Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum by (instance) (celeriant_client_connections_active)", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Leader Elections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum by (instance) (celeriant_leader_elections_total)", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Clock Drift (ms)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "celeriant_clock_drift_ms", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "max": 5000
        }
      }
    },
    {
      "title": "Throughput",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Write Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_writes_total[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Read Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_reads_total[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Write Throughput (bytes/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_write_bytes_total[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "title": "Read Throughput (bytes/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_read_bytes_total[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "title": "Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "title": "Write Latency (p50 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, instance) (rate(celeriant_write_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{instance}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(celeriant_write_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Read Latency (p50 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, instance) (rate(celeriant_read_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{instance}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(celeriant_read_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Fsync Latency (p50 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, instance) (rate(celeriant_fsync_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{instance}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(celeriant_fsync_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Replication Latency (p50 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, instance) (rate(celeriant_replication_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{instance}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(celeriant_replication_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Durability & Replication",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": false
    },
    {
      "title": "Fsync Batch Size",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_fsync_batch_size_sum[$__rate_interval])) / clamp_min(sum by (instance) (rate(celeriant_fsync_batch_size_count[$__rate_interval])), 1e-15)", "legendFormat": "avg {{instance}}" }]
    },
    {
      "title": "Replication Queue",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        { "expr": "sum by (instance) (celeriant_replication_queue_bytes) / sum by (instance) (celeriant_replication_queue_high_water_bytes)", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "title": "S3 Fallbacks / Rollbacks",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        { "expr": "sum by (instance) (rate(celeriant_replication_s3_fallbacks_total[$__rate_interval]))", "legendFormat": "s3_fallback {{instance}}" },
        { "expr": "sum by (instance) (rate(celeriant_replication_rollbacks_total[$__rate_interval]))", "legendFormat": "rollback {{instance}}" }
      ]
    },
    {
      "title": "Cache",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "collapsed": false
    },
    {
      "title": "Recent Write Cache Hit Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 49 },
      "targets": [{
        "expr": "sum by (instance) (rate(celeriant_cache_recent_write_hits_total[$__rate_interval])) / clamp_min(sum by (instance) (rate(celeriant_cache_recent_write_hits_total[$__rate_interval])) + sum by (instance) (rate(celeriant_cache_recent_write_misses_total[$__rate_interval])), 1e-15)",
        "legendFormat": "{{instance}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "Aggregate Snapshot Cache Hit Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 49 },
      "targets": [{
        "expr": "sum by (instance) (rate(celeriant_cache_aggregate_snapshot_hits_total[$__rate_interval])) / clamp_min(sum by (instance) (rate(celeriant_cache_aggregate_snapshot_hits_total[$__rate_interval])) + sum by (instance) (rate(celeriant_cache_aggregate_snapshot_misses_total[$__rate_interval])), 1e-15)",
        "legendFormat": "{{instance}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "Log File Cache Hit Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 49 },
      "targets": [{
        "expr": "sum by (instance) (rate(celeriant_cache_log_file_hits_total[$__rate_interval])) / clamp_min(sum by (instance) (rate(celeriant_cache_log_file_hits_total[$__rate_interval])) + sum by (instance) (rate(celeriant_cache_log_file_misses_total[$__rate_interval])), 1e-15)",
        "legendFormat": "{{instance}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "WAL & Storage",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "collapsed": false
    },
    {
      "title": "WAL Index (per shard)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 58 },
      "targets": [{ "expr": "celeriant_wal_index", "legendFormat": "{{instance}} shard={{shard_id}}" }]
    },
    {
      "title": "Log Segments",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 58 },
      "targets": [{ "expr": "sum by (instance) (celeriant_log_segments_total)", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Log Rotations Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 58 },
      "targets": [{ "expr": "sum by (instance) (rate(celeriant_log_rotations_total[$__rate_interval]))", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Errors & Stability",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 66 },
      "collapsed": false
    },
    {
      "title": "Error Rates",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 67 },
      "targets": [
        { "expr": "sum by (instance, error_code) (rate(celeriant_write_errors_total[$__rate_interval]))", "legendFormat": "write_err {{error_code}} {{instance}}" },
        { "expr": "sum by (instance, error_code) (rate(celeriant_read_errors_total[$__rate_interval]))", "legendFormat": "read_err {{error_code}} {{instance}}" }
      ]
    },
    {
      "title": "Shard Panics & Restarts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 67 },
      "targets": [
        { "expr": "sum by (instance) (celeriant_shard_panics_total)", "legendFormat": "panics {{instance}}" },
        { "expr": "sum by (instance) (celeriant_shard_restarts_total)", "legendFormat": "restarts {{instance}}" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["celeriant"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Celeriant Cluster",
  "uid": "celeriant-cluster",
  "version": 1
}
