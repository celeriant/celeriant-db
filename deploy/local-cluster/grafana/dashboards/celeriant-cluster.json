        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 106 },
        "targets": [{ "expr": "sum by (instance, shard_id) (rate(celeriant_replication_applied_bytes_total{instance=~\"$instance\", shard_id=~\"$shard_id\"}[$__rate_interval]))", "legendFormat": "s={{shard_id}} {{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "Bps" } }
      }
    ] }
