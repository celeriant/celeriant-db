        "targets": [{ "expr": "celeriant_wal_index{instance=~\"$instance\", shard_id=~\"$shard_id\"}", "legendFormat": "{{instance}} shard={{shard_id}}" }]
      },
      {
        "title": "Replication Health Signals by Shard",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 98 },
        "targets": [
          { "expr": "sum by (instance, shard_id) (rate(celeriant_replicate_stale_lease_total{instance=~\"$instance\", shard_id=~\"$shard_id\"}[$__rate_interval]))", "legendFormat": "stale_lease s={{shard_id}} {{instance}}" },
          { "expr": "sum by (instance, shard_id) (rate(celeriant_replication_tip_hash_mismatch_kick_total{instance=~\"$instance\", shard_id=~\"$shard_id\"}[$__rate_interval]))", "legendFormat": "tip_hash s={{shard_id}} {{instance}}" },
          { "expr": "sum by (instance, shard_id) (rate(celeriant_replication_intra_batch_chain_break_total{instance=~\"$instance\", shard_id=~\"$shard_id\"}[$__rate_interval]))", "legendFormat": "chain_break s={{shard_id}} {{instance}}" },
          { "expr": "sum by (instance, shard_id) (rate(celeriant_follower_auto_fence_total{instance=~\"$instance\", shard_id=~\"$shard_id\"}[$__rate_interval]))", "legendFormat": "auto_fence s={{shard_id}} {{instance}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "ops" } }
      },
      {
        "title": "Lease Budget Exhausted by Shard / Op",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "celeriant-prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 106 },
