# RPi kTLS Cluster Configuration
# Edit these to match your network setup.
#
# WARNING: cs1, cs2 and cs3 are NOT a disposable rig. They also run users' real production software.
# Changing REMOTE_DATA_ROOT below is the one edit that can destroy prod, which is why
# guard-prod pins it to an allow-list.
#
# Two scenarios are host-scoped and reach prod no matter what things are named:
# fill-disk fills the filesystem, skew-clock moves the whole host clock. Both
# need celeriant-prod stopped ON THE TARGET BOX ONLY; the pair keeps serving
# from the other node, so this stays compatible with prod running 24/7.

# Data nodes (RPi 5s running Celeriant)
# Use IPs, not hostnames — RPi cloud-init maps all hostnames to 127.0.1.1
# in /etc/hosts, so inter-node DNS resolution is unreliable.
LEADER_HOST=192.168.88.214
FOLLOWER_HOST=192.168.88.213

# Infra hosts (MinIO, Grafana, Prometheus, Loki).
# Both addresses live here so flipping INFRA_MODE is the only edit needed.
# cs1/cs2 reach MinIO at the resolved INFRA_HOST — the Makefile picks the
# right one based on INFRA_MODE and `make deploy` re-syncs the systemd
# unit so the change takes effect without re-running setup-nodes.
INFRA_HOST_REMOTE=192.168.88.78
INFRA_HOST_LOCAL=192.168.88.250

# remote = SSH into INFRA_HOST_REMOTE (cs3).
# local  = docker compose on this build machine (reachable at INFRA_HOST_LOCAL).
INFRA_MODE=remote

# SSH user (must have sudo access on all nodes)
SSH_USER=${USER}

# Celeriant build
CARGO_TARGET=aarch64-unknown-linux-gnu
CELERIANT_BINARY=target/${CARGO_TARGET}/release/celeriant
WAL_INSPECT_BINARY=target/${CARGO_TARGET}/release/celeriant-wal-inspect

# Paths on the RPi nodes
REMOTE_BIN=/usr/local/bin/celeriant
REMOTE_WAL_INSPECT_BIN=/usr/local/bin/celeriant-wal-inspect
REMOTE_DATA_ROOT=/var/lib/nvme/celeriant-data
REMOTE_CERT_DIR=/etc/celeriant/certs
NVME_DEVICE=/dev/nvme0n1
NVME_PARTITION=/dev/nvme0n1p1

# Local cert output directory
CERT_DIR=certs

# Celeriant ports
CLIENT_PORT=10000
REPLICATION_PORT=10001
METRICS_PORT=9090

# S3 (MinIO on infra node)
S3_BUCKET=celeriant-cluster
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Celeriant tuning
MEMORY_CONSUMPTION_PERCENT=60
SHARD_LOG_PREALLOCATE_BYTES=268435456
RESERVE_COORDINATOR_SHARD=true

# Integration test settings
CLUSTER_THROUGHPUT_CONNECTIONS=8000
CLUSTER_LATENCY_CONNECTIONS=125
CLUSTER_DURATION=60
