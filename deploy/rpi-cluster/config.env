# RPi kTLS Cluster Configuration
# Edit these to match your network setup.

# Data nodes (RPi 5s running Celeriant)
# Use IPs, not hostnames — RPi cloud-init maps all hostnames to 127.0.1.1
# in /etc/hosts, so inter-node DNS resolution is unreliable.
LEADER_HOST=10.0.0.50
FOLLOWER_HOST=10.0.0.51

# Infra node (Ubuntu PC on the testbed LAN)
INFRA_HOST=10.0.0.1

# SSH user (must have sudo access on all nodes)
SSH_USER=${USER}

# Celeriant build
CARGO_TARGET=aarch64-unknown-linux-gnu
CELERIANT_BINARY=target/${CARGO_TARGET}/release/celeriant

# Paths on the RPi nodes
REMOTE_BIN=/usr/local/bin/celeriant
REMOTE_DATA_ROOT=/var/lib/celeriant
REMOTE_CERT_DIR=/etc/celeriant/certs
NVME_DEVICE=/dev/nvme0n1
NVME_PARTITION=/dev/nvme0n1p1

# Local cert output directory
CERT_DIR=certs

# Celeriant ports
CLIENT_PORT=10000
REPLICATION_PORT=10001
METRICS_PORT=9090

# S3 (MinIO on infra node)
S3_BUCKET=celeriant-cluster
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Celeriant tuning
MEMORY_CONSUMPTION_PERCENT=60
SHARD_LOG_PREALLOCATE_BYTES=134217728
RESERVE_COORDINATOR_SHARD=true

# Integration test settings
CLUSTER_THROUGHPUT_CONNECTIONS=8000
CLUSTER_LATENCY_CONNECTIONS=125
CLUSTER_DURATION=15
