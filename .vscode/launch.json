{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug exists_benchmark",
            "cargo": {
                "args": [
                    "build",
                    "--bench",
                    "exists_benchmark",
                    "-p",
                    "celeriant_shard"
                ],
                "filter": {
                    "name": "exists_benchmark",
                    "kind": "bench"
                }
            },
            "args": [
                "--bench",
                "--nocapture"
            ],
            "cwd": "${workspaceFolder}",
            "env": {}
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug celeriant (debug build)",
            "cargo": {
                "args": [
                    "build",
                    "-p",
                    "celeriant"
                ],
                "filter": {
                    "name": "celeriant",
                    "kind": "bin"
                }
            },
            "args": [
                "--routing-rule",
                "org",
                "--num-shards",
                "1",
                "--shard-log-preallocate-bytes",
                "20971520",
            ],
            "cwd": "${workspaceFolder}",
            "env": {}
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug celeriant as leader (debug build)",
            "cargo": {
                "args": [
                    "build",
                    "-p",
                    "celeriant"
                ],
                "filter": {
                    "name": "celeriant",
                    "kind": "bin"
                }
            },
            "args": [
                "--data-root",
                "data_leader",
                "--num-shards",
                "1",
                "--client-port",
                "10000",
                "--replication-port",
                "10001",
                "--cluster-role",
                "leader",
                "--follower-address",
                "127.0.0.1:10003"
            ],
            "cwd": "${workspaceFolder}",
            "env": {}
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug celeriant distributed + S3 (single node)",
            "cargo": {
                "args": [
                    "build",
                    "-p",
                    "celeriant"
                ],
                "filter": {
                    "name": "celeriant",
                    "kind": "bin"
                }
            },
            "args": [
                "--num-shards",
                "3",
                "--shard-log-preallocate-bytes",
                "20971520",
                "--log-level",
                "debug",
                "--s3-enabled",
                "--s3-region",
                "us-east-1",
                "--s3-bucket",
                "celeriant",
                "--s3-access-key-id",
                "minioadmin",
                "--s3-secret-access-key",
                "minioadmin",
                "--s3-endpoint-override",
                "http://127.0.0.1:9000",
                "--s3-allow-http"
            ],
            "cwd": "${workspaceFolder}",
            "env": {}
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug batch_main",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "batch_main",
                    "-p",
                    "celeriant_integration_tests",
                ],
                "filter": {
                    "name": "batch_main",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {}
        }
    ]
}