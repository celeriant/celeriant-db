{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug celeriant (debug build)",
            "cargo": {
                "args": [
                    "build",
                    "-p",
                    "celeriant"
                ],
                "filter": {
                    "name": "celeriant",
                    "kind": "bin"
                }
            },
            "args": ["--listen-address", "0.0.0.0:10000", "--num-shards", "1", "--shard-log-preallocate-bytes", "20971520", "--non-durable-writes"],
            "cwd": "${workspaceFolder}",
            "env": {}
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug batch_main",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "batch_main",
                    "-p",
                    "celeriant_client_demo",
                ],
                "filter": {
                    "name": "batch_main",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {}
        }
    ]
}