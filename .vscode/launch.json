{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug eventplanedb_server (S3)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=eventplanedb_server",
                    "--package=eventplanedb_server"
                ],
                "filter": {
                    "name": "eventplanedb_server",
                    "kind": "bin"
                }
            },
            "args": [
                "--s3-enabled",
                "--s3-region", "ap-southeast-2",
                "--s3-bucket", "eventplanedb-testing",
                "--s3-access-key-id", "AWS_ACCESS_KEY_ID_REDACTED_PRE_PUBLICATION_SEE_PROVENANCE_MD",
                "--s3-secret-access-key", "AWS_SECRET_ACCESS_KEY_REDACTED_PRE_PUBLICATION_SEE_PROVENANCE_MD",
                "--s3-subfolder", "test-ubuntu-pc",
                "--num-shards", "1"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug single_main",
            "cargo": {
                "args": [
                    "build",
                    "--bin=single_main",
                    "--package=eventplanedb_client_example"
                ],
                "filter": {
                    "name": "single_main",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}