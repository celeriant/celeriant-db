{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RandomWorkload",
            "type": "cppvsdbg", // Use "cppvsdbg" for Windows instead of "lldb"
            "request": "launch",
            "program": "${workspaceFolder}\\target\\debug\\eventplanedb.exe",
            "args": [
                "random-workload",
                "http://192.168.0.109",
