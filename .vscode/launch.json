{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug celeriant (debug build)",
            "cargo": {
                "args": [
                    "build",
                    "-p",
                    "celeriant"
                ],
                "filter": {
                    "name": "celeriant",
                    "kind": "bin"
                }
            },
            "args": ["--num-shards", "1", "--aggregate-snapshots-cache-bytes", "224"],
            "cwd": "${workspaceFolder}",
            "env": {}
        }
    ]
}